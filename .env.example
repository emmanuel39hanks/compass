# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# --- Venice AI ---
VENICE_API_KEY=
# Optional: override the default tool-capable model (resolve current ids via GET /models)
VENICE_MODEL=qwen3-next-80b

# --- Operator / agent key (burner) ---
# A 0x-prefixed 32-byte private key. Fund it with testnet USDC on Base Sepolia.
COMPASS_PRIVATE_KEY=

# --- Network ---
# 84532 = Base Sepolia (testnet, free), 8453 = Base mainnet (for the 1Shot prize)
COMPASS_CHAIN_ID=84532
# testnet | mainnet  (selects the 1Shot relayer endpoint)
COMPASS_RELAYER=testnet
# Optional RPC override; defaults to the public Base RPC for the chosen chain
COMPASS_RPC_URL=
