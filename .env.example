# compass — copy to `.env` and fill in. Used by `compass serve` and docker compose.
# (.env is gitignored — never commit your real secrets.)

# 1) Your agent's wallet — a burner private key. Fund it with a little Base Sepolia
#    USDC so it can act. Faucet: https://faucet.circle.com
COMPASS_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# 2) Venice API key — free at https://venice.ai/settings/api/keys
VENICE_API_KEY=YOUR_VENICE_KEY

# 3) Your Telegram bot token — create your own bot with @BotFather
#    (https://t.me/BotFather). You run the bot; we don't host it for you.
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN

# --- Config (optional). `compass init` writes these; set them for a headless deploy. ---
COMPASS_NETWORK=base-sepolia
COMPASS_AGENT_NAME=scout
COMPASS_BUDGET=25 USDC/week
